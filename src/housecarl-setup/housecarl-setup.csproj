<Project Sdk="Microsoft.NET.Sdk">

  <!--
    houseCARL Codex setup utility (no CLI, no GUI). The double-click installer copies the bundled
    server under the user's local application data, copies skills into ~/.agents/skills/, and
    registers the MCP server in ~/.codex/config.toml. The MO2 folder is set later in chat on first
    use (houseCARL self-configures via housecarl_set_mo2_instance), so this utility needs no UI.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HousecarlSetup</RootNamespace>
    <AssemblyName>houseCARL-Setup</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
